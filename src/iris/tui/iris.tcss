Screen {
    background: #0d0b09;
    color: #efe8dc;
}

#shell {
    height: 1fr;
}

#side {
    width: 30;
    height: 1fr;
    padding: 2 2 1 2;
    border-right: vkey #2a231b;
    background: #0d0b09;
}

#orb {
    margin: 0 0 1 0;
}

#state {
    width: 100%;
    text-align: center;
    color: #6f665b;
    text-style: italic;
    height: 1;
}

#state.active {
    color: #e9b04c;
}

#side-rule {
    height: 1;
    margin: 1 0;
    border-top: solid #2a231b;
}

#model {
    color: #efe8dc;
    text-style: bold;
    height: auto;
}

#who {
    color: #a0968a;
    margin: 1 0 0 0;
    height: auto;
}

#usage {
    color: #a0968a;
    margin: 1 0 0 0;
    height: auto;
}

.spent {
    margin: 0 0 0 2;
    color: #4a4239;
    height: auto;
}

#facts {
    color: #6f665b;
    margin: 1 0 0 0;
    height: auto;
}

#version {
    dock: bottom;
    color: #4a4239;
}

#main {
    width: 1fr;
    height: 1fr;
}

#log {
    padding: 1 4 1 3;
    scrollbar-color: #3a3128;
    scrollbar-color-hover: #e9b04c;
    scrollbar-background: #0d0b09;
    scrollbar-size-vertical: 1;
}

#welcome {
    height: auto;
    padding: 2 0 0 0;
}

#hello {
    color: #e9b04c;
    text-style: bold;
}

#tagline {
    color: #a0968a;
    margin: 0 0 1 0;
}

.suggestion {
    width: auto;
    height: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: none;
    background: #0d0b09;
    color: #a0968a;
    text-style: none;
    content-align: left middle;
}

.suggestion:hover, .suggestion:focus {
    background: #0d0b09;
    color: #e9b04c;
    text-style: none;
    border: none;
}

.user {
    height: auto;
    margin: 1 0 0 0;
}

.caret {
    width: 2;
    color: #6f665b;
}

.said {
    width: 1fr;
    color: #a99f92;
}

.iris {
    height: auto;
    margin: 1 0 0 0;
}

.dot {
    width: 2;
    color: #e9b04c;
}

.iris Markdown {
    width: 1fr;
    height: auto;
    margin: 0;
    padding: 0;
    background: #0d0b09;
}

MarkdownBullet {
    color: #e9b04c;
}

MarkdownH1, MarkdownH2, MarkdownH3 {
    color: #e9b04c;
    background: #0d0b09;
}

MarkdownFence {
    background: #15120e;
    margin: 1 0;
    padding: 0 1;
}

.tool {
    height: auto;
    margin: 0 0 0 2;
    color: #6f665b;
}

.tool.done {
    color: #8e8758;
}

.tool.failed {
    color: #e5644f;
}

.preview {
    margin: 0 0 0 4;
    padding: 0;
    border: none;
    background: #0d0b09;
    height: auto;
}

.preview > CollapsibleTitle {
    color: #6f665b;
    background: #0d0b09;
    padding: 0;
}

.preview > CollapsibleTitle:hover, .preview > CollapsibleTitle:focus {
    color: #e9b04c;
    background: #0d0b09;
}

.preview > Contents {
    padding: 0 0 0 2;
    border-left: vkey #2a231b;
    height: auto;
}

.preview Markdown {
    background: #0d0b09;
    margin: 0;
    padding: 0;
}

.notice {
    margin: 1 0 0 2;
    color: #6f665b;
    text-style: italic;
}

#bottom {
    dock: bottom;
    height: auto;
    padding: 0 4 0 3;
}

#commands {
    display: none;
    height: auto;
    max-height: 12;
    margin: 0 0 0 0;
    padding: 0 1;
    background: #15120e;
    border: round #3a3128;
    scrollbar-size-vertical: 1;
}

#commands.visible {
    display: block;
}

#commands > .option-list--option-highlighted {
    background: #2a2016;
}

#replies {
    height: auto;
    display: none;
    margin: 0 0 1 0;
}

#replies.visible {
    display: block;
}

#replies Button {
    margin: 0 1 0 0;
    min-width: 14;
    height: 3;
    background: #0d0b09;
    color: #e9b04c;
    border: round #3a3128;
}

#replies Button:hover, #replies Button:focus {
    background: #e9b04c;
    color: #1a1206;
    border: round #e9b04c;
}

#prompt {
    padding: 0 1;
    background: #0d0b09;
    border: round #3a3128;
    color: #efe8dc;
}

#prompt:focus {
    border: round #e9b04c;
}

#prompt > .input--placeholder {
    color: #5a5148;
}

#prompt > .input--cursor {
    background: #e9b04c;
    color: #1a1206;
}

#status {
    height: 1;
    padding: 0 1;
}

#hints {
    width: 1fr;
    color: #4a4239;
}

#keys {
    width: auto;
    color: #4a4239;
}

ApprovalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}

#approval {
    width: 72;
    height: auto;
    padding: 1 2;
    background: #15120e;
    border: round #e9b04c;
}

#approval-title {
    color: #e9b04c;
    text-style: bold;
}

#approval-detail {
    color: #efe8dc;
    margin: 1 0;
}

#approval-buttons {
    height: auto;
    align: right middle;
}

#approval-buttons Button {
    margin: 0 0 0 1;
}
